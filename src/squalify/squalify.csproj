<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>squalor.squalify</AssemblyName>
    <RootNamespace>squalor.squalify</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>squalor.squalify</PackageId>
    <Description>Profiles one data file into a deterministic JSON descriptor: encoding, format, layout, fields, statistics and structural fingerprint. The library behind the squalify CLI.</Description>
    <PackageTags>squalify;profiling;descriptor;csv;data-profiling</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>squalify-512.png</PackageIcon>
    <!-- Package validation: dotnet pack fails when the public API no longer matches the baseline package on nuget.org (the
         1.x promise). The baseline is a PackageDownload, so restore fetches it and a pack without restore reads it from the
         NuGet cache. Library only; see docs/release.md, "Package validation". -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="squalify.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\squalify-512.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
