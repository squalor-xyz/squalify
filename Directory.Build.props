<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Jon Robbins</Authors>
    <RepositoryUrl>https://github.com/squalor-xyz/squalify</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/squalor-xyz/squalify</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Version>0.1.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <!-- Symbol packages (snupkg) for every packable project. Only projects that set IsPackable pack at all. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- ContinuousIntegrationBuild is passed only to the release pack steps (release.yml). Setting it for every
         CI build maps source paths to /_/, which breaks the tests that locate fixtures through CallerFilePath. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile Condition="'$(MSBuildProjectName)' == 'squalify'">true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
